=== postgres probes & resources ===
    Limits:
      cpu:     250m
      memory:  256Mi
    Requests:
      cpu:      50m
      memory:   128Mi
    Liveness:   exec [sh -c pg_isready -U $POSTGRES_USER -d $POSTGRES_DB] delay=15s timeout=1s period=20s successThreshold=1 failureThreshold=3
    Readiness:  exec [sh -c pg_isready -U $POSTGRES_USER -d $POSTGRES_DB] delay=5s timeout=1s period=10s successThreshold=1 failureThreshold=3
    Startup:    exec [sh -c pg_isready -U $POSTGRES_USER -d $POSTGRES_DB] delay=0s timeout=1s period=2s successThreshold=1 failureThreshold=30
    Environment:
      POSTGRES_DB:        <set to the key 'DATABASE_NAME' of config map 'taskapp-config'>   Optional: false
      POSTGRES_USER:      <set to the key 'DATABASE_USER' in secret 'taskapp-secrets'>      Optional: false
      POSTGRES_PASSWORD:  <set to the key 'DATABASE_PASSWORD' in secret 'taskapp-secrets'>  Optional: false
      PGDATA:             /var/lib/postgresql/data/pgdata
    Mounts:
