# --- Secrets & state: NEVER commit. The grader runs `git log -p` looking for these. ---
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example
crash.log

# personal, not secret — whoever provisions brings their own keypair
infra/terraform/taskappkey-created.pub
!infra/terraform/taskappkey-created.pub.example

# kubeconfig & cluster joins
kubeconfig
*kubeconfig*
k3s.yaml
node-token
*.token
infra/ansible/inventory/hosts.yaml
!infra/ansible/inventory/hosts.yaml.example
infra/ansible/inventory/group_vars/all.yml
!infra/ansible/inventory/group_vars/all.yml.example
infra/ansible/fetched/

# secrets / env
.env
.env.*
!.env.example
*secret*.yaml
!*secret*.example.yaml
*.pem
*.key
id_rsa*

# argo / helm local
charts/*.tgz

# os / editor
.DS_Store
*.swp
.idea/
.vscode/
